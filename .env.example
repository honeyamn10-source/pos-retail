# Server secrets: configure through the hosting secret manager.
JAWA_SERVICE_OWNER=
JAWA_VOICE_TOKEN=
JAWA_PRINTER_TOKEN=

# External adapters only. Never expose these to the browser.
JAWA_SITES_GATE_TOKEN=
JAWA_VOICE_ENDPOINT=
JAWA_PRINTER_ENDPOINT=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
JAWA_STT_MODEL=
JAWA_LLM_MODEL=
JAWA_TTS_MODEL=
JAWA_STAFF_PHONE=
JAWA_VOICE_JOURNAL=
JAWA_PRINTER_HOST=
JAWA_PRINTER_PROFILE=
JAWA_PRINT_JOURNAL=

# Optional direct ordering owner. Without this, only the signed-in owner's private preview works.
JAWA_ONLINE_OWNER=
# Normalized partner-bridge contract, separate from native provider webhook authentication.
JAWA_CHANNEL_TOKEN=
JAWA_DOORDASH_STORE_ID=
JAWA_UBEREATS_STORE_ID=
JAWA_SKIP_STORE_ID=
