[Unit]
Description=Jawa POS server
After=network.target
[Service]
Type=simple
User=jawa
WorkingDirectory=/opt/jawa
Environment=NODE_ENV=production
EnvironmentFile=/opt/jawa/.env.server
ExecStart=/usr/bin/node server-dist/main.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jawa/data
[Install]
WantedBy=multi-user.target
